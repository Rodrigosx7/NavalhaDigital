# Copie para .env.local; nunca envie credenciais pelo chat ou para o Git.
# Sem DATABASE_URL, npm run dev continua usando SQLite local.
# DATABASE_URL é PostgreSQL/Supavisor Transaction pooler, não a URL https do projeto.
DATABASE_URL=
# Conexão owner/direct ou session pooler para db:migrate/importar; somente na máquina do operador.
DATABASE_MIGRATION_URL=
# Base64 dos mesmos 32 bytes da chave local, se houver importação. Nunca gerar outra para dados existentes.
NAVALHA_ENCRYPTION_KEY=
# Produção: domínio final exato, HTTPS, sem barra final. Local: http://127.0.0.1:5174
APP_ORIGIN=http://127.0.0.1:5174
# Opcional: certificado CA privado da conexão, em PEM. Nunca desabilitar validação TLS.
NAVALHA_DATABASE_CA=
